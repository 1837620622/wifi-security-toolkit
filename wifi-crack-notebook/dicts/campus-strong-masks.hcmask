# ============================================================================
# 校园场景强密码掩码文件 (针对 Xiaomi_A380 校园路由器)
# 核心策略：M1 Metal GPU 可承受的 keyspace (≤ 5G)
# 覆盖：学号、身份证生日、强密码模式（字母+数字+特殊）、SSID 定向前缀
# ============================================================================

# ── A. 身份证生日掩码 (YYYYMMDD 8位) ──
# 19YY年份 + MM月 + DD日 (keyspace ≈ 3.7M)
19?d?d?d?d?d?d
# 20YY 年份 (keyspace ≈ 366K)
20?d?d?d?d?d?d
# 年份 19xx-20xx + 0101 等固定日期
19?d?d0101
19?d?d0520
19?d?d0808
19?d?d1212
19?d?d1225

# ── B. 学号 8-10 位掩码 ──
# 年份 2015-2026 + 4 位序号 (keyspace ≈ 1.2M)
201?d?d?d?d?d
202?d?d?d?d?d
2015?d?d?d?d
2016?d?d?d?d
2017?d?d?d?d
2018?d?d?d?d
2019?d?d?d?d
2020?d?d?d?d
2021?d?d?d?d
2022?d?d?d?d
2023?d?d?d?d
2024?d?d?d?d
2025?d?d?d?d
# 10 位学号 (年+6位)
2020?d?d?d?d?d?d
2021?d?d?d?d?d?d
2022?d?d?d?d?d?d
2023?d?d?d?d?d?d
2024?d?d?d?d?d?d
2025?d?d?d?d?d?d

# ── C. 小米/A380 前缀固定 + 4-6 位数字尾 ──
# 非常定向，keyspace 极小，值得跑
xiaomi?d?d
xiaomi?d?d?d
xiaomi?d?d?d?d
xiaomi?d?d?d?d?d
xiaomi?d?d?d?d?d?d
xiaomi?d?d?d?d?d?d?d?d
Xiaomi?d?d?d?d
Xiaomi?d?d?d?d?d?d
Xiaomi?d?d?d?d?d?d?d?d
xiaomia380?d?d
xiaomia380?d?d?d
xiaomia380?d?d?d?d
xiaomi_a380?d?d
xiaomi_a380?d?d?d
xiaomi_a380?d?d?d?d
Xiaomi_A380?d?d
Xiaomi_A380?d?d?d
Xiaomi_A380?d?d?d?d
a380?d?d?d?d
a380?d?d?d?d?d?d
a380?d?d?d?d?d?d?d?d
A380?d?d?d?d
A380?d?d?d?d?d?d
A380?d?d?d?d?d?d?d?d

# ── D. 强密码掩码：大写开头 + 小写 + 数字 (≤ 5G keyspace) ──
# ?u?l?l?l?l?d?d?d (1大+4小+3数 = 8位)  keyspace ≈ 11.8G — 太大，跳过
# 改为更定向：
# 7 位字母 + 1 数字
?u?l?l?l?l?l?l?d
?u?l?l?l?l?l?l?d?d
# 4 字母 + 4 数字 (首字母大写)
?u?l?l?l?d?d?d?d
# 5 字母 + 3 数字
?u?l?l?l?l?d?d?d

# ── E. 强密码掩码：包含特殊字符 ──
# 自定义字符集: ?1 = ! @ # . _ & * 常见特殊
# 4 字母 + 3 数字 + 1 特殊
!@#._&*,?1,?u?l?l?l?d?d?d?1
# 5 字母 + 2 数字 + 1 特殊
!@#._&*,?1,?u?l?l?l?l?d?d?1
# 6 字母 + 1 数字 + 1 特殊
!@#._&*,?1,?u?l?l?l?l?l?d?1
# 5 字母 + 3 数字 + 1 特殊 (9位)
!@#._&*,?1,?u?l?l?l?l?d?d?d?1

# ── F. 纯小写字母 8-9 位（英文/拼音） ──
# keyspace ?l^8 = 208G — 超过 M1 能承受，改为定向前缀
# 以 a/q/w 等常见首字母开头
a?l?l?l?l?l?l?d
q?l?l?l?l?l?l?d
w?l?l?l?l?l?l?d
x?l?l?l?l?l?l?d
m?l?l?l?l?l?l?d
# admin/root/user 开头 + 数字
admin?d?d?d?d
admin?d?d?d?d?d
admin?d?d?d?d?d?d
admin?d?d?d?d?d?d?d?d
root?d?d?d?d
root?d?d?d?d?d?d
root?d?d?d?d?d?d?d?d
wifi?d?d?d?d
wifi?d?d?d?d?d?d
wifi?d?d?d?d?d?d?d?d
home?d?d?d?d
home?d?d?d?d?d?d
home?d?d?d?d?d?d?d?d
love?d?d?d?d
love?d?d?d?d?d?d
love?d?d?d?d?d?d?d?d

# ── G. 中国典型：姓拼音(2-4字母) + 生日6-8位数字 ──
# 2 字母姓 + 8 位身份证生日 = 10 位
?l?l19?d?d?d?d?d?d
?l?l20?d?d?d?d?d?d
# 3 字母姓 + 8 位 = 11 位
?l?l?l19?d?d?d?d?d?d
# 2 字母 + 6 位 (YYMMDD)
?l?l?d?d?d?d?d?d
# 3 字母 + 6 位
?l?l?l?d?d?d?d?d?d
# 4 字母 + 6 位
?l?l?l?l?d?d?d?d?d?d
# 5 字母 + 6 位
?l?l?l?l?l?d?d?d?d?d?d

# ── H. 数字+字母反向（中国也很常见） ──
?d?d?d?d?d?d?l?l
?d?d?d?d?d?d?l?l?l
?d?d?d?d?d?d?d?d?l?l
?d?d?d?d?d?d?d?d?l?l?l
# 生日+姓
19?d?d?d?d?d?d?l?l
20?d?d?d?d?d?d?l?l

# ── I. a380 / A380 尾缀（反向：前面加内容） ──
# ?l?l?l?l?l?la380 (6小写+a380=10位)
?l?l?l?l?l?la380
?l?l?l?l?l?l?la380
?l?l?l?l?la380
# 数字 + a380
?d?d?d?da380
?d?d?d?d?d?da380
?d?d?d?d?d?d?d?da380

# ── J. Xiaomi + 混合字符 ──
# Xiaomi + 4 位混合 (字母数字)
xiaomi?l?l?l?l
xiaomi?d?l?l?l
xiaomi?l?d?d?d
xiaomi?d?d?l?l
# 8 位以上纯字母+数字混合
?u?l?l?l?l?l?d?d?d
?u?l?l?l?l?d?d?d?d
?u?l?l?l?l?l?l?l?d

# ── K. SSID变体 + 带特殊字符尾 ──
# 2 位字母大小写混合 + 'a380' + 数字
?u?la380?d?d?d?d
?u?l?la380?d?d?d
A380?u?l?l?l?l
a380?u?l?l?l?l
